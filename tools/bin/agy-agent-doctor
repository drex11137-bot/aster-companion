#!/usr/bin/env bash
# ==============================================================================
# AGY-AGENT-DOCTOR: Diagnostic Command for Agent Platform, Skills & Subagents
# ==============================================================================
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "\n${BOLD}${CYAN}===================================================================${NC}"
echo -e "${BOLD}${CYAN}            ANTIGRAVITY AGENT PLATFORM & MEMORY DOCTOR             ${NC}"
echo -e "${BOLD}${CYAN}===================================================================${NC}\n"

echo -e "${BOLD}1. Core Platform Files:${NC}"
echo -n "  [AGENTS.md] Root Master Guide... "
if [ -f "AGENTS.md" ]; then
    SIZE=$(stat -c%s "AGENTS.md" 2>/dev/null || wc -c < "AGENTS.md")
    echo -e "${GREEN}PASS${NC} (${SIZE} bytes)"
else
    echo -e "${RED}FAIL${NC} (Missing AGENTS.md)"
fi

echo -n "  [Hooks] .agents/hooks.json... "
if [ -f ".agents/hooks.json" ]; then
    if jq empty ".agents/hooks.json" >/dev/null 2>&1; then
        HOOK_GROUPS=$(jq 'keys | length' ".agents/hooks.json" 2>/dev/null || echo "0")
        echo -e "${GREEN}PASS${NC} (${HOOK_GROUPS} hook groups declared)"
    else
        echo -e "${RED}FAIL${NC} (JSON Syntax Error)"
    fi
else
    echo -e "${RED}FAIL${NC} (Missing .agents/hooks.json)"
fi

for hook_file in "pre_invocation.py" "pre_tool_use.py" "post_tool_use.py" "stop_hook.py"; do
    echo -n "    - scripts/hooks/${hook_file}... "
    if [ -f "scripts/hooks/${hook_file}" ]; then
        if python3 -m py_compile "scripts/hooks/${hook_file}" >/dev/null 2>&1; then
            echo -e "${GREEN}PASS${NC} (syntax valid)"
        else
            echo -e "${RED}FAIL${NC} (syntax error)"
        fi
    else
        echo -e "${RED}FAIL${NC} (missing)"
    fi
done

echo -e "\n${BOLD}2. Domain Skills & Subagents:${NC}"
echo -n "  [Skills] .agents/skills/... "
if [ -d ".agents/skills" ]; then
    SKILL_COUNT=$(find .agents/skills -mindepth 1 -maxdepth 1 -type d | wc -l)
    echo -e "${GREEN}PASS${NC} (${SKILL_COUNT} domain skills found)"
else
    echo -e "${RED}FAIL${NC} (Missing .agents/skills directory)"
fi

echo -n "  [Subagents] .agents/agents/... "
if [ -d ".agents/agents" ]; then
    AGENT_COUNT=$(find .agents/agents -mindepth 1 -maxdepth 1 -type d | wc -l)
    echo -e "${GREEN}PASS${NC} (${AGENT_COUNT} custom subagents defined)"
else
    echo -e "${RED}FAIL${NC} (Missing .agents/agents directory)"
fi

echo -e "\n${BOLD}3. Persistent Memory System:${NC}"
echo -n "  [Memory] .agents/memory/... "
if [ -d ".agents/memory" ]; then
    echo -e "${GREEN}PASS${NC}"
    [ -f ".agents/memory/CURRENT.md" ] && echo -e "    - CURRENT.md: ${GREEN}PASS${NC}" || echo -e "    - CURRENT.md: ${YELLOW}MISSING${NC}"
    [ -f ".agents/memory/INDEX.md" ] && echo -e "    - INDEX.md: ${GREEN}PASS${NC}" || echo -e "    - INDEX.md: ${YELLOW}MISSING${NC}"
else
    echo -e "${RED}FAIL${NC} (Missing .agents/memory directory)"
fi

echo -e "\n${BOLD}${CYAN}===================================================================${NC}"
echo -e "${GREEN}Agent Platform Doctor inspection complete.${NC}\n"
