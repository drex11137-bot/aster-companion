#!/usr/bin/env bash
# ==============================================================================
# AGY-ANDROID-DOCTOR: Diagnostic Command for Android & RE Subsystem
# ==============================================================================
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

JSON_MODE=false
for arg in "$@"; do
    if [ "$arg" == "--json" ]; then
        JSON_MODE=true
    fi
done

declare -a JSON_ENTRIES=()
OVERALL_PASS=true

record_check() {
    local category="$1"
    local name="$2"
    local status="$3"
    local info="$4"
    local path="${5:-}"

    if [ "$JSON_MODE" = true ]; then
        local clean_info
        clean_info=$(echo "$info" | tr '\r\n' ' ' | sed 's/"/\\"/g' | sed 's/[[:space:]]*$//')
        JSON_ENTRIES+=("{\"category\":\"$category\",\"name\":\"$name\",\"status\":\"$status\",\"info\":\"$clean_info\",\"path\":\"$path\"}")
    else
        local status_color="$GREEN"
        if [ "$status" != "PASS" ]; then
            status_color="$RED"
            OVERALL_PASS=false
        fi
        echo -e "  [${category}] ${name}... ${status_color}${status}${NC} (${info})"
    fi
}

check_tool() {
    local category="$1"
    local name="$2"
    local cmd="$3"
    local ver_cmd="$4"

    local bin_path
    bin_path=$(command -v "${cmd}" 2>/dev/null || true)
    if [ -n "${bin_path}" ] && [ -x "${bin_path}" ]; then
        local ver
        ver=$(eval "${ver_cmd}" 2>&1 | head -n1 || echo "Available")
        ver=$(echo "$ver" | tr '\r\n' ' ' | sed 's/[[:space:]]*$//')
        record_check "$category" "$name" "PASS" "$ver" "$bin_path"
    else
        record_check "$category" "$name" "FAIL" "Binary not found in PATH" ""
    fi
}

if [ "$JSON_MODE" = false ]; then
    echo -e "\n${BOLD}${CYAN}===================================================================${NC}"
    echo -e "${BOLD}${CYAN}                ANTIGRAVITY ANDROID SUBSYSTEM DOCTOR               ${NC}"
    echo -e "${BOLD}${CYAN}===================================================================${NC}\n"
    echo -e "${BOLD}1. Android SDK & Environment:${NC}"
fi

SDK_DIR="${ANDROID_HOME:-/usr/local/android-sdk}"
if [ -d "$SDK_DIR" ]; then
    record_check "SDK" "ANDROID_HOME" "PASS" "$SDK_DIR" "$SDK_DIR"
else
    record_check "SDK" "ANDROID_HOME" "FAIL" "SDK directory not found" ""
fi

if [ "$JSON_MODE" = false ]; then
    echo -e "\n${BOLD}2. Core Android CLI Tools:${NC}"
fi
check_tool "Android" "Android Debug Bridge (adb)" "adb" "adb version | head -n1"
check_tool "Android" "SDK Manager (sdkmanager)" "sdkmanager" "sdkmanager --version"
check_tool "Android" "APK Signer (apksigner)" "apksigner" "apksigner --version"
check_tool "Android" "ZipAlign (zipalign)" "zipalign" "echo 'Installed'"
check_tool "Android" "AAPT2 (Asset Packaging Tool)" "aapt2" "aapt2 version 2>&1"
check_tool "Android" "D8 Dex Compiler" "d8" "d8 --version 2>&1"
check_tool "Android" "APK Analyzer (apkanalyzer)" "apkanalyzer" "echo 'Installed'"

if [ "$JSON_MODE" = false ]; then
    echo -e "\n${BOLD}3. Reverse Engineering & Binary Tools:${NC}"
fi
check_tool "Android-RE" "APKTool Decompiler" "apktool" "apktool -version"
check_tool "Android-RE" "JADX DEX Decompiler" "jadx" "jadx --version"
check_tool "Android-RE" "Frida Dynamic Instrumenter" "frida" "frida --version"
check_tool "Android-RE" "Smali Assembler" "smali" "smali --version"
check_tool "Android-RE" "Baksmali Disassembler" "baksmali" "baksmali --version"
check_tool "Android-RE" "Uber-APK-Signer" "uber-apk-signer" "uber-apk-signer --version"
check_tool "Android-RE" "Quark Malware Scoring" "quark" "quark --version 2>&1 | grep -o 'quark, version .*' || echo 'Installed'"

if [ "$JSON_MODE" = false ]; then
    echo -e "\n${BOLD}4. Android Build Fixture Verification:${NC}"
fi

APK_PATH="fixtures/android/app/build/outputs/apk/debug/app-debug.apk"
if [ -f "$APK_PATH" ]; then
    record_check "Fixture" "Debug APK Existence" "PASS" "Present ($(ls -lh "$APK_PATH" | awk '{print $5}'))" "$APK_PATH"
    
    if command -v zipalign >/dev/null 2>&1; then
        if zipalign -c -v 4 "$APK_PATH" >/dev/null 2>&1; then
            record_check "Fixture" "ZipAlign 4-byte Boundary" "PASS" "Alignment verified" "$APK_PATH"
        else
            record_check "Fixture" "ZipAlign 4-byte Boundary" "FAIL" "Alignment failed" "$APK_PATH"
        fi
    fi

    if command -v apksigner >/dev/null 2>&1; then
        if apksigner verify "$APK_PATH" >/dev/null 2>&1; then
            record_check "Fixture" "APK Signature Integrity" "PASS" "v2 signature valid" "$APK_PATH"
        else
            record_check "Fixture" "APK Signature Integrity" "FAIL" "Signature verification failed" "$APK_PATH"
        fi
    fi
else
    record_check "Fixture" "Debug APK Existence" "WARN" "Not built yet ($APK_PATH)" ""
fi

if [ "$JSON_MODE" = true ]; then
    echo "{\"status\":\"$([ "$OVERALL_PASS" = true ] && echo "PASS" || echo "FAIL")\",\"checks\":[$(IFS=,; echo "${JSON_ENTRIES[*]}")]}"
else
    echo -e "\n${BOLD}${CYAN}===================================================================${NC}"
    if [ "$OVERALL_PASS" = true ]; then
        echo -e "${GREEN}✔ All Android & RE checks passed successfully.${NC}\n"
    else
        echo -e "${RED}✘ Some Android & RE checks failed.${NC}\n"
        exit 1
    fi
fi
