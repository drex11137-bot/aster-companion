#!/usr/bin/env bash
# ==============================================================================
# AGY-BINARY-DOCTOR: Diagnostic Command for Binary Analysis & WASM Subsystem
# ==============================================================================
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "\n${BOLD}${CYAN}===================================================================${NC}"
echo -e "${BOLD}${CYAN}            ANTIGRAVITY BINARY & WASM DOCTOR                       ${NC}"
echo -e "${BOLD}${CYAN}===================================================================${NC}\n"

check_bin_tool() {
    local category="$1"
    local name="$2"
    local cmd="$3"
    local ver_cmd="$4"

    echo -n "  [${category}] ${name}... "
    if command -v "${cmd}" >/dev/null 2>&1; then
        local ver
        ver=$(eval "${ver_cmd}" 2>/dev/null | head -n1 || echo "Available")
        echo -e "${GREEN}PASS${NC} (${ver})"
    else
        echo -e "${YELLOW}UNAVAILABLE${NC}"
    fi
}

echo -e "${BOLD}1. Disassembly, Debugging & Decompilation:${NC}"
check_bin_tool "Binary" "GDB (GNU Debugger)" "gdb" "gdb --version | head -n1"
check_bin_tool "Binary" "LLDB (LLVM Debugger)" "lldb" "lldb --version | head -n1"
check_bin_tool "Binary" "Radare2 Framework" "r2" "r2 -v | head -n1"
check_bin_tool "Binary" "Rizin Framework" "rizin" "rizin -v | head -n1"
check_bin_tool "Binary" "Checksec Hardening Tool" "checksec" "checksec --version 2>&1 | head -n1 || echo 'Installed'"

echo -n "  [Binary] Ghidra Headless Analyzer... "
if [ -x "${GHIDRA_HOME:-/usr/local/ghidra}/support/analyzeHeadless" ]; then
    echo -e "${GREEN}PASS${NC} (${GHIDRA_HOME:-/usr/local/ghidra})"
elif [ -x "/opt/ghidra/support/analyzeHeadless" ]; then
    echo -e "${GREEN}PASS${NC} (/opt/ghidra)"
else
    echo -e "${YELLOW}UNAVAILABLE${NC}"
fi

echo -e "\n${BOLD}2. Core Binary Utilities:${NC}"
check_bin_tool "Core" "file (File Type Identifier)" "file" "file -v | head -n1"
check_bin_tool "Core" "readelf (ELF Parser)" "readelf" "readelf -v | head -n1"
check_bin_tool "Core" "objdump (Object Dumper)" "objdump" "objdump -v | head -n1"
check_bin_tool "Core" "nm (Symbol Lister)" "nm" "nm -V | head -n1"
check_bin_tool "Core" "strings (String Extractor)" "strings" "strings -v | head -n1"

echo -e "\n${BOLD}3. WebAssembly (WASM) Toolchain:${NC}"
check_bin_tool "WASM" "wat2wasm (WABT Assembler)" "wat2wasm" "wat2wasm --version"
check_bin_tool "WASM" "wasm2wat (WABT Disassembler)" "wasm2wat" "wasm2wat --version"
check_bin_tool "WASM" "wasm-validate" "wasm-validate" "wasm-validate --version"
check_bin_tool "WASM" "wasm-opt (Binaryen)" "wasm-opt" "wasm-opt --version"
check_bin_tool "WASM" "Wasmtime Runtime" "wasmtime" "wasmtime --version"
check_bin_tool "WASM" "Wasmer Runtime" "wasmer" "wasmer --version"

echo -e "\n${BOLD}${CYAN}===================================================================${NC}"
echo -e "${GREEN}Binary & WASM Doctor inspection complete.${NC}\n"
